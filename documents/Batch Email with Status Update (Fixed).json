      "parameters": {
        "jsCode": "// Process ALL items, not just the first one\nconst items = $input.all();\n\nconsole.log(`Processing ${items.length} client(s)`);\n\nconst results = items.map((item, index) => {\n  const data = item.json;\n  \n  console.log(`Client ${index + 1}:`, data.clientData?.name || 'Unknown');\n  \n  // Preserve the data we need for later nodes\n  const result = {\n    junctionRecordId: data.junctionRecordId || '',\n    clientEmail: (data.clientData && data.clientData.email) || '',\n    emailSubject: data.emailSubject || '',\n    emailContent: data.emailContent || '',\n    clientName: (data.clientData && data.clientData.name) || 'Unknown'\n  };\n  \n  if (!result.junctionRecordId) {\n    throw new Error(`Missing junctionRecordId for client: ${result.clientName}`);\n  }\n  \n  if (!result.clientEmail) {\n    throw new Error(`Missing clientEmail for client: ${result.clientName}`);\n  }\n  \n  return { json: result };\n});\n\nconsole.log(`Successfully processed ${results.length} client(s)`);\n\nreturn results;\n"
      },
